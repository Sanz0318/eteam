  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码，与 HTTP 状态码语义一致"
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "description": "业务数据，结构随接口而定；无数据时为 null"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "example": "admin"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "LoginData": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT 凭证",
            "example": "eyJhbGciOiJIUzI1NiJ9..."
          }
        }
      },
      "CheckData": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean",
            "description": "是否允许；未命中/用户停用或不存在均为 false（默认拒绝）"
          }
        }
      },
      "UserRequest": {
        "type": "object",
        "description": "创建时 username/password 必填；修改时只传需要变更的字段（password 传入即重置密码）",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "description": "登录账号，唯一"
          },
          "password": {
            "type": "string",
            "description": "明文密码，服务端 BCrypt 加密存储"
          },
          "nickname": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 启用 / 0 停用",
            "example": 1
          }
        }
      },
      "RoleRequest": {
        "type": "object",
        "description": "创建时 roleName/roleCode 必填；修改时只传需要变更的字段",
        "properties": {
          "roleName": {
            "type": "string",
            "maxLength": 64
          },
          "roleCode": {
            "type": "string",
            "maxLength": 64,
            "description": "角色编码，唯一",
            "example": "ORDER_ADMIN"
          },
          "level": {
            "type": "integer",
            "description": "管理员等级，可自定义，数值越小等级越高",
            "example": 0
          },
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "status": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "example": 1
          }
        }
      },
      "PermissionRequest": {
        "type": "object",
        "description": "创建时 permissionName/resource/operation/permissionCode 必填；permissionCode 唯一，形如 resource:operation",
        "properties": {
          "permissionName": {
            "type": "string",
            "maxLength": 64,
            "example": "删除订单"
          },
          "resource": {
            "type": "string",
            "maxLength": 64,
            "example": "order"
          },
          "operation": {
            "type": "string",
            "maxLength": 64,
            "example": "delete"
          },
          "permissionCode": {
            "type": "string",
            "maxLength": 128,
            "example": "order:delete"
          },
          "description": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "IdArray": {
        "type": "array",
        "items": {
          "type": "integer",
          "format": "int64"
        },
        "description": "整体替换语义：传 [1,3] 表示最终恰好拥有 1、3；传 [] 表示清空（跨部门回收）",
        "example": [
          1,
          3
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "description": "1 启用 / 0 停用"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "roleName": {
            "type": "string"
          },
          "roleCode": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Permission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "permissionName": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "permissionCode": {
            "type": "string",
            "example": "order:delete"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "parameters": {
      "idPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "参数/业务错误（如唯一性冲突）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            },
            "example": {
              "code": 400,
              "message": "账号已存在",
              "data": null
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未认证：缺少/无效/过期 token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            },
            "example": {
              "code": 401,
              "message": "token 无效或已过期",
              "data": null
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            },
            "example": {
              "code": 404,
              "message": "用户不存在",
              "data": null
            }
          }
        }
      }
    }
  }
}
