{
  "openapi": "3.0.3",
  "info": {
    "title": "统一权限管理系统 API",
    "version": "1.1.0",
    "description": "RBAC0 权限管理接口（RESTful），可导入 Apifox/Swagger。\n\n认证：除 login/logout/check 外，均需请求头 `Authorization: Bearer <token>`。\n统一响应体：`{ code, message, data }`。\n错误约定：HTTP 状态码与 body.code 语义一致（200 成功 / 400 参数或业务错误 / 401 未认证 / 404 不存在 / 500 服务错误）；鉴权检查永不因权限不足报错，未命中即 `allowed:false`（默认拒绝）。"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "认证",
      "description": "登录/登出/鉴权检查"
    },
    {
      "name": "用户管理",
      "description": "用户 CRUD 与用户-角色分配（UA）"
    },
    {
      "name": "角色管理",
      "description": "角色 CRUD 与角色-权限分配（PA）"
    },
    {
      "name": "权限管理",
      "description": "权限 CRUD（权限 = 资源 + 操作）"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "登录",
        "description": "校验账号密码与用户状态，成功返回 JWT。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功，data.token 为 JWT",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/LoginData"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "登出",
        "description": "JWT 无状态实现，登出由客户端销毁本地 token，服务端无状态可清。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/check": {
      "get": {
        "tags": [
          "认证"
        ],
        "summary": "鉴权检查（接入系统调用）",
        "description": "只读查询：沿 用户→(UA)→角色→(PA)→权限 单条联表 COUNT 判定。未命中/用户不存在/停用均返回 allowed:false（默认拒绝），不会返回 4xx。",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "permissionCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "user:create"
          }
        ],
        "responses": {
          "200": {
            "description": "data.allowed 是否允许",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CheckData"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
